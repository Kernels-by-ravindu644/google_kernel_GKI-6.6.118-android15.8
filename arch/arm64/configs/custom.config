# keep our own release string
# CONFIG_LOCALVERSION_AUTO is not set

# KernelSU-next
CONFIG_KSU=y

# cfg80211 and rtl8821au
# NEVER set CONFIG_CFG80211_WEXT: it changes struct wiphy/wireless_dev and with
# them every cfg80211 symbol CRC. With it off our cfg80211 is ABI-identical to
# the stock vendor_dlkm cfg80211.ko, so 8821au.ko loads against the stock one.
CONFIG_CFG80211=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8821AU=m

# mac80211 + mt76x0u (MediaTek MT7610U USB adapters). mac80211 must stay
# ABI-identical to the stock vendor_dlkm mac80211.ko: no MESH (it bumps
# MAX_HEADER in netdevice.h and with it every skb/netdev/device CRC), no
# DEBUGFS/LEDS/TESTMODE.
CONFIG_MAC80211=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT76x0U=m
