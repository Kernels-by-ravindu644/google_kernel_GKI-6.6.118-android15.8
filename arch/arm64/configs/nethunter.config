# General
CONFIG_DEFAULT_HOSTNAME="kali"

# Modules
CONFIG_MODULE_FORCE_UNLOAD=y

# External USB Wi-Fi adapters (Alfa AWUS036ACM etc. / Realtek RTL8811AU/RTL8821AU)
# Vendored morrownr/8821au driver (drivers/net/wireless/realtek/rtl8821au),
# built as a loadable module. Driver uses cfg80211 directly (no mac80211).
CONFIG_USB=y
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8821AU=m
